#!/bin/sh
# Refuse pushes to main. Only a merged pull request should move main.
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "pre-push: refusing to push directly to '$remote_ref'. Open a pull request instead." >&2
      exit 1;;
  esac
done
exit 0
